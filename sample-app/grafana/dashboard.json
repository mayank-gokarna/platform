{
  "annotations": {
    "list": []
  },
  "description": "Sample App observability dashboard — RED metrics from Prometheus",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_total{app=\"sample-app\"}[5m])",
          "legendFormat": "{{method}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{app=\"sample-app\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{app=\"sample-app\"}[5m])) * 100",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100
        }
      }
    },
    {
      "title": "Request Duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{app=\"sample-app\"}[5m])) by (le))",
          "legendFormat": "p95 latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Request Duration (p50)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{app=\"sample-app\"}[5m])) by (le))",
          "legendFormat": "p50 latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Page Views (browser)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(sample_app_page_views_total{app=\"sample-app\"}[5m]))",
          "legendFormat": "catalog page views/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "title": "Total Page Views",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(sample_app_page_views_total{app=\"sample-app\"})",
          "legendFormat": "views",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      }
    },
    {
      "title": "Catalog Clicks by Item",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "sum by (section, item) (ui_button_clicks_total{app=\"sample-app\"})",
          "legendFormat": "{{section}} / {{item}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "orientation": "horizontal"
      }
    },
    {
      "title": "Last Page View (time endpoint was hit)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "max(sample_app_last_page_view_timestamp_seconds{app=\"sample-app\"}) * 1000",
          "legendFormat": "last hit",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "noValue": "No page views yet"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "none"
      }
    },
    {
      "title": "Time Since Last Page View",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "time() - max(sample_app_last_page_view_timestamp_seconds{app=\"sample-app\"})",
          "legendFormat": "ago",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "noValue": "No page views yet"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "none"
      }
    },
    {
      "title": "Items Currently in Cart by Item",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "clamp_min(sum by (section, item) (sample_app_cart_items_added_total{app=\"sample-app\"}) - sum by (section, item) (sample_app_cart_items_removed_total{app=\"sample-app\"}), 0)",
          "legendFormat": "{{section}} / {{item}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Cart is empty"
        }
      },
      "options": {
        "orientation": "horizontal"
      }
    },
    {
      "title": "Current Items in Cart",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "targets": [
        {
          "expr": "clamp_min(sum(sample_app_cart_items_added_total{app=\"sample-app\"}) - sum(sample_app_cart_items_removed_total{app=\"sample-app\"}), 0)",
          "legendFormat": "items",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "value"
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["sample-app", "flask", "red-metrics"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Sample App Dashboard",
  "uid": "sample-app-dashboard",
  "version": 5
}

